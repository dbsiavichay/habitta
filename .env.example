# Copia este archivo a .env.docker (Docker) o .env.local (fuera de Docker) y ajusta los valores.
# Las integraciones externas son opcionales: si se dejan vacías quedan deshabilitadas.

# --- Django ---
DEBUG=False
# Obligatoria con DEBUG=False. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Detrás de un proxy HTTPS (nginx, balanceador): activa cookies seguras, HSTS y redirección
SECURE_SSL=False
# Servir /media desde Django (por defecto sólo con DEBUG=True)
# SERVE_MEDIA=False

# --- Marca y contacto (vacíos = no se muestran en el sitio) ---
SITE_NAME=Habitta
SITE_TAGLINE=Inmuebles, servicios y empleos cerca de ti
# Razón social de los términos y condiciones (vacía = SITE_NAME). Ver `manage.py rebrand_content`.
LEGAL_NAME=
# URL pública sin barra final (enlaces absolutos, QR del PDF, OpenGraph)
SITE_URL=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_X=

# --- Base de datos y Redis (docker-compose ya los define para el contenedor web) ---
# DATABASE_URL=postgis://habitta:habitta@localhost:5432/habitta
# REDIS_URL=redis://localhost:6379/0

# --- Email (vacío = backend de consola) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Mapas (libres, sin key). Comentadas = valores por defecto; vacías = deshabilitado ---
# Estilo vectorial de MapLibre (OpenFreeMap: positron, liberty, bright…)
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Photon (OpenStreetMap) para buscar lugares; el público es de uso justo: para producción, autoalojarlo.
# GEOCODER_URL=https://photon.komoot.io
# Tiles raster del mapa del afiche en PDF (MAP_TILE_SCALE=2 si el proveedor sirve tiles @2x)
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_SCALE=1
# MAP_TILE_ATTRIBUTION=© OpenStreetMap
# Cómo se identifica la app ante OpenStreetMap y Photon (mejor con una URL de contacto)
# GEO_USER_AGENT=Habitta/1.0 (+https://tu-dominio)

# --- PayPal (Orders v2). PAYPAL_MODE: sandbox | live ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Login social ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- Tinify (compresión de imágenes; vacío = compresión local con Pillow) ---
TINIFY_API_KEY=
