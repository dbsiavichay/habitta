# Copia este archivo a .env.docker (Docker) o .env.local (fuera de Docker) y ajusta los valores.
# Las integraciones externas son opcionales: si se dejan vacías quedan deshabilitadas.

# --- Django ---
DEBUG=False
# Obligatoria con DEBUG=False. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Detrás de un proxy HTTPS (nginx, balanceador): activa cookies seguras, HSTS y redirección
SECURE_SSL=False
# Servir /media desde Django (por defecto sólo con DEBUG=True)
# SERVE_MEDIA=False

# --- Base de datos y Redis (docker-compose ya los define para el contenedor web) ---
# DATABASE_URL=postgis://larbit:larbit@localhost:5432/larbit
# REDIS_URL=redis://localhost:6379/0

# --- Email (vacío = backend de consola) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Google Maps (JavaScript API, Places y Static Maps) ---
# Restríngela por dominio (HTTP referrer) en la consola de Google Cloud: viaja al navegador.
GOOGLE_MAPS_API_KEY=
# Key para la Geocoding API desde el navegador (vacía = se usa GOOGLE_MAPS_API_KEY)
GOOGLE_GEOCODING_API_KEY=

# --- PayPal (Orders v2). PAYPAL_MODE: sandbox | live ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Login social ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- Tinify (compresión de imágenes; vacío = compresión local con Pillow) ---
TINIFY_API_KEY=
