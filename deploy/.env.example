# /opt/habitta/.env en el VPS (chmod 600). Ver deploy/README.md.
#
# Lo que describe el cableado del stack (DEBUG, dominio, ALLOWED_HOSTS, SECURE_SSL,
# DATABASE_URL, REDIS_URL) está fijo en compose.yml y le gana a este archivo.
# WEB_TAG lo escribe scripts/deploy.sh: no editarlo a mano.

# --- Obligatorias -----------------------------------------------------------------
# Genéralas en el VPS, en hexadecimal: van dentro de DATABASE_URL y compose interpola `$`.
#   openssl rand -hex 24   (POSTGRES_PASSWORD)
#   openssl rand -hex 32   (SECRET_KEY)
# No rotes SECRET_KEY a la ligera: cierra todas las sesiones e invalida los enlaces de
# recuperación de contraseña ya enviados.
POSTGRES_PASSWORD=
SECRET_KEY=

# --- Marca y contacto (vacíos = no se muestran) -----------------------------------
SITE_NAME=Habitta
SITE_TAGLINE=Inmuebles, servicios y empleos cerca de ti
LEGAL_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_X=

# --- Mapas (libres, sin key) ----------------------------------------------------------
# OpenStreetMap y Photon piden que cada app se identifique con una URL de contacto.
GEO_USER_AGENT=Habitta/1.0 (+https://habitta.dbsiavichay.dev)

# --- Email (vacío = el correo sale por la consola, es decir, a los logs) ----------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- PayPal (Orders v2). PAYPAL_MODE: sandbox | live -----------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Login social ---------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- Tinify (vacío = compresión local con Pillow) ----------------------------------------
TINIFY_API_KEY=

# --- Logs -----------------------------------------------------------------------------
LOG_LEVEL=INFO
